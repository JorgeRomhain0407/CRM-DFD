# ============================================================
#  farmacia-sync — Middleware entre el TPV de la farmacia y el CRM DFD
#  Copia este archivo a .env y rellena los valores de tu TPV.
# ============================================================

# --- Servidor (lado farmacia) ----------------------------------
# Puerto del servidor HTTP que expone el catálogo
FARMACIA_SYNC_PORT=4000
# Token para proteger /productos (déjalo vacío en pruebas locales; ponlo SIEMPRE en producción)
FARMACIA_SYNC_TOKEN=

# --- Conexión a la BD local del TPV ----------------------------
# tipo: sqlite | mssql | mysql | postgres
FARMACIA_SYNC_DB_TIPO=sqlite

# sqlite:
FARMACIA_SYNC_DB_FILE=C:/farmacia/tpv.db
#VACIO para el resto de motores. mssql/mysql/postgres:
FARMACIA_SYNC_DB_SERVER=localhost
FARMACIA_SYNC_DB_PORT=
FARMACIA_SYNC_DB_USER=
FARMACIA_SYNC_DB_PASSWORD=
FARMACIA_SYNC_DB_DATABASE=tpv

# --- Tabla/vista del catálogo -----------------------------------
FARMACIA_SYNC_DB_TABLA=productos
# WHERE opcional, ej: "activo = 1"
FARMACIA_SYNC_DB_DONDE=

# --- Mapeo de columnas del TPV ---------------------------------
FARMACIA_SYNC_COL_SKU=codigo
FARMACIA_SYNC_COL_NOMBRE=nombre
FARMACIA_SYNC_COL_DESCRIPCION=descripcion
FARMACIA_SYNC_COL_PRECIO=pvpu
FARMACIA_SYNC_COL_PRECIOUSD=precio_usd
FARMACIA_SYNC_COL_STOCK=stock
# Marca/fabricante del producto (opcional; vacío = sin marca)
FARMACIA_SYNC_COL_MARCA=

# --- Perfil del TPV (opcional) ----------------------------------
# soinfarma: el driver lee la MARCA y los LOTES directamente de las tablas
# base del TPV (PRODUCTO/FABRICANTE/PRODUCTOLOTE/INVENTARIO). No requiere
# crear vistas en el TPV; solo permiso de SELECT (el de la app ya lo tiene).
# Con este perfil no hace falta configurar FARMACIA_SYNC_LOTES_TABLA.
FARMACIA_SYNC_PERFIL=

# --- Lotes con vencimiento (FEFO), OPCIONAL --------------------
# Deja FARMACIA_SYNC_LOTES_TABLA vacío para desactivar la sincronización
# de lotes. Los lotes se leen de la MISMA BD del TPV ya configurada arriba.
# La tabla/vista debe exponer: sku del producto, código de lote,
# fecha de vencimiento (date o varchar YYYY-MM-DD) y stock del lote.
FARMACIA_SYNC_LOTES_TABLA=
FARMACIA_SYNC_LOTES_DONDE=
# Columnas de la tabla de lotes (valores por defecto entre paréntesis)
FARMACIA_SYNC_LOTES_COL_SKU=sku
FARMACIA_SYNC_LOTES_COL_LOTE=lote
FARMACIA_SYNC_LOTES_COL_FECHA_VENCIMIENTO=fecha_vencimiento
FARMACIA_SYNC_LOTES_COL_STOCK=stock

# Recuerda ejecutar antes la migración FEFO en Supabase (canónica):
#   farmacia-sync/sql/migracion-fefo-lotes.sql

# ============================================================
#  Consumidor (lado CRM): URL y token del servidor farmacia
# ============================================================
CRM_SYNC_URL=http://localhost:4000
CRM_SYNC_TOKEN=
# Supabase (usa las mismas claves que el CRM principal)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Intervalo de sincronización en minutos
CRM_SYNC_INTERVAL_MIN=15
