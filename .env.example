PORT=3000
NODE_ENV=development

# Prefijo E.164 si WhatsApp envía el número sin '+'
DEFAULT_PHONE_PREFIX=+34

# Meta Cloud API
META_VERIFY_TOKEN=cambia-este-token
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OpenAI (Responses API — no hace falta crear un asistente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (service_role: solo backend, nunca en el navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API del mostrador (header x-api-key)
MOSTRADOR_API_KEY=cambia-esta-clave
