PORT=3000
# Interfaz de escucha. Con '127.0.0.1' solo es accesible detrás del proxy
# (nginx) en la propia máquina; vacío/0.0.0.0 expone el puerto a internet.
HOST=127.0.0.1
NODE_ENV=development

# Prefijo E.164 si WhatsApp envía el número sin '+'
DEFAULT_PHONE_PREFIX=+34

# Meta Cloud API
META_VERIFY_TOKEN=cambia-este-token
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OpenAI (Responses API — no hace falta crear un asistente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase (service_role: solo backend, nunca en el navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sesiones del panel (#V59). Obligatorio en producción: firma las cookies de
# sesión (HttpOnly). Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio
# Duración de la sesión en segundos (por defecto 12 h)
SESSION_MAX_AGE_SEC=43200

# Gestor inicial: se crea automáticamente la PRIMERA vez (si la tabla usuarios
# está vacía). Solo se usa una vez; puedes borrarlas del .env después.
GESTOR_INICIAL_USUARIO=gestor
GESTOR_INICIAL_PASSWORD=cambia-esta-contrasena
GESTOR_INICIAL_NOMBRE=Gestor

# URL pública del panel del mostrador (enlaces en las notificaciones de handoff)
PANEL_URL=http://localhost:3000

# Minutos sin atención en esperando_operador antes de re-alertar al mostrador
HANDOFF_ALERTA_MINUTOS=30
